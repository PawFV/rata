# RATA - Audit Rules for auditd
# Comprehensive system activity monitoring

# Remove previous rules
-D

# Configure buffer
-b 8192

# Fail if buffer fills (don't lose events)
-f 1

# ============================================================================
# PROCESS EXECUTION
# ============================================================================

# Monitor all program executions
-a always,exit -F arch=b64 -S execve -k exec
-a always,exit -F arch=b32 -S execve -k exec

# ============================================================================
# NETWORK CONNECTIONS
# ============================================================================

# Socket creation
-a always,exit -F arch=b64 -S socket -k network_socket
-a always,exit -F arch=b32 -S socket -k network_socket

# Connect (outbound connections)
-a always,exit -F arch=b64 -S connect -k network_connect
-a always,exit -F arch=b32 -S connect -k network_connect

# Accept (inbound connections)
-a always,exit -F arch=b64 -S accept,accept4 -k network_accept
-a always,exit -F arch=b32 -S accept,accept4 -k network_accept

# Bind (listening ports)
-a always,exit -F arch=b64 -S bind -k network_bind
-a always,exit -F arch=b32 -S bind -k network_bind

# ============================================================================
# CRITICAL FILE MODIFICATION
# ============================================================================

# Authentication files
-w /etc/passwd -p wa -k auth_file
-w /etc/shadow -p wa -k auth_file
-w /etc/group -p wa -k auth_file
-w /etc/gshadow -p wa -k auth_file
-w /etc/sudoers -p wa -k auth_file
-w /etc/sudoers.d/ -p wa -k auth_file

# SSH
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /root/.ssh/ -p wa -k ssh_keys
-w /home/ -p wa -k user_home

# PAM
-w /etc/pam.d/ -p wa -k pam

# Cron and scheduled tasks
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron

# Systemd
-w /etc/systemd/ -p wa -k systemd
-w /lib/systemd/ -p wa -k systemd
-w /usr/lib/systemd/ -p wa -k systemd

# Network configuration
-w /etc/hosts -p wa -k network_config
-w /etc/resolv.conf -p wa -k network_config
-w /etc/network/ -p wa -k network_config
-w /etc/NetworkManager/ -p wa -k network_config

# LD_PRELOAD and libraries
-w /etc/ld.so.conf -p wa -k lib_preload
-w /etc/ld.so.conf.d/ -p wa -k lib_preload
-w /etc/ld.so.preload -p wa -k lib_preload

# Init scripts
-w /etc/init.d/ -p wa -k init
-w /etc/rc.local -p wa -k init

# ============================================================================
# KERNEL AND MODULES
# ============================================================================

# Kernel module loading
-a always,exit -F arch=b64 -S init_module,finit_module -k kernel_module
-a always,exit -F arch=b32 -S init_module,finit_module -k kernel_module

# Module removal
-a always,exit -F arch=b64 -S delete_module -k kernel_module
-a always,exit -F arch=b32 -S delete_module -k kernel_module

# Sysctl changes
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d/ -p wa -k sysctl

# ============================================================================
# SUSPICIOUS ACTIVITY
# ============================================================================

# Access to /dev/mem and /dev/kmem
-a always,exit -F arch=b64 -S open -F path=/dev/mem -k dev_mem
-a always,exit -F arch=b64 -S open -F path=/dev/kmem -k dev_mem

# ptrace (debugging/injection)
-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace

# Process injection
-a always,exit -F arch=b64 -S process_vm_writev -k process_inject
-a always,exit -F arch=b32 -S process_vm_writev -k process_inject

# Time changes (anti-forensics)
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time_change

# Filesystem mounting
-a always,exit -F arch=b64 -S mount,umount2 -k mounts
-a always,exit -F arch=b32 -S mount,umount2 -k mounts

# Hostname changes
-a always,exit -F arch=b64 -S sethostname,setdomainname -k hostname

# ============================================================================
# SENSITIVE FILE ACCESS
# ============================================================================

# Critical binaries
-w /bin/ -p x -k bin_exec
-w /sbin/ -p x -k sbin_exec
-w /usr/bin/ -p x -k usr_bin_exec
-w /usr/sbin/ -p x -k usr_sbin_exec

# Temporary files (common malware location)
-w /tmp/ -p x -k tmp_exec
-w /var/tmp/ -p x -k var_tmp_exec
-w /dev/shm/ -p x -k shm_exec

# ============================================================================
# PRIVILEGES
# ============================================================================

# Privilege changes
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid -k priv_change
-a always,exit -F arch=b32 -S setuid,setgid,setreuid,setregid -k priv_change

# Capabilities
-a always,exit -F arch=b64 -S capset -k capabilities

# ============================================================================
# MAKE RULES IMMUTABLE (uncomment in production)
# ============================================================================
# -e 2

